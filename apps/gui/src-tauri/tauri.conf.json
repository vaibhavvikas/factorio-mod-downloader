{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Factorio Mod Downloader",
  "version": "0.3.6",
  "identifier": "com.vaibhavvikas.factorio-mod-downloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Factorio Mod Downloader",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#0d1117",
        "shadow": true,
        "windowEffects": {
          "effects": ["sidebar", "mica"],
          "state": "followsWindowActiveState",
          "radius": 12
        },
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app.png",
      "icons/app.icns",
      "icons/app.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
