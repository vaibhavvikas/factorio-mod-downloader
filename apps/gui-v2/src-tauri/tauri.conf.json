{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gui-v2",
  "version": "0.1.0",
  "identifier": "com.vaibhav.factorio-mod-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app.png",
      "icons/app.icns",
      "icons/app.ico"
    ]
  }
}
